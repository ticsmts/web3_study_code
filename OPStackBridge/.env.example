# ========== L1 配置 ==========
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<YOUR_API_KEY>
PRIVATE_KEY=<你的私钥，不带0x前缀>

# ========== L2 配置 (选择一个) ==========

# Option 1: Optimism Sepolia
L2_RPC_URL=https://sepolia.optimism.io
L1_STANDARD_BRIDGE=0xFBb0621E0B23b5478B630BD55a5f21f67730B0F1
L2_EXPLORER=https://sepolia-optimism.etherscan.io

# Option 2: Base Sepolia (取消注释以使用)
# L2_RPC_URL=https://sepolia.base.org
# L1_STANDARD_BRIDGE=0xfd0Bf71F60660E2f608ed56e1659C450eB113120
# L2_EXPLORER=https://sepolia.basescan.org

# ========== L2 Factory (通用) ==========
L2_FACTORY=0x4200000000000000000000000000000000000012

# ========== Token 参数 ==========
TOKEN_NAME=My Bridge Token
TOKEN_SYMBOL=MBT
INITIAL_MINT=10000
L2_TOKEN_NAME=My Bridge Token (L2)
L2_TOKEN_SYMBOL=MBT.L2

# ========== 跨链参数 ==========
BRIDGE_AMOUNT=100000000000000000000
MIN_GAS_LIMIT=200000

# ========== 部署后填写 ==========
L1_TOKEN=
L2_TOKEN=
